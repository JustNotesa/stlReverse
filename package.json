{
  "name": "stl-reverse",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "description": "Firefox/Chrome Add-on zur heuristischen Rückführung von STL-Meshes in parametrische Beschreibungen",
  "main": "analysis-core.js",
  "scripts": {
    "test": "node tests/run-all.mjs",
    "test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:e2e": "node --experimental-vm-modules node_modules/jest/bin/jest.js --testMatch '<rootDir>/tests/e2e/**/*.test.js'",
    "test:bore": "node tests/bore-analytic-regression.mjs",
    "lint": "web-ext lint",
    "build:xpi": "web-ext build --overwrite-dest --filename \"stl-reverse-{version}.xpi\" --ignore-files tests \"tests/**\" samples \"samples/**\" test-results \"test-results/**\" archive \"archive/**\" cst-test \"cst-test/**\" web-ext-artifacts \"web-ext-artifacts/**\" segmentation.js panel4.json updates.json \"*.md\" package.json package-lock.json",
    "test:golden": "node tests/golden-regression.mjs",
    "test:ebike": "node tests/ebike-scorecard.mjs",
    "test:collinear": "node tests/collinear-regression.mjs",
    "test:v2": "node tests/fixtures-v2/check.mjs --quick",
    "test:tube": "node tests/tube-regression.mjs",
    "test:mantel": "node tests/mantle-regression.mjs",
    "test:orient": "node tests/orientation-guard.mjs",
    "test:strict": "node tests/step-strict.mjs"
  },
  "jest": {
    "testMatch": [
      "<rootDir>/tests/*.test.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/\\.claude/"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/\\.claude/"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "jest": "^30.2.0",
    "puppeteer": "^24.35.0"
  },
  "dependencies": {
    "occt-import-js": "^0.0.23",
    "online-3d-viewer": "^0.18.0"
  }
}
