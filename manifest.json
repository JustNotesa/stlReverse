{
  "manifest_version": 2,
  "name": "STL Reverse Parametric Sketch",
  "version": "0.2.3",
  "description": "Wandelt STL-Dreiecksnetze in STEP-Volumenkörper um: Verrundungen entfernen, Bohrungen und Mäntel als echte Zylinder, gebogene Kanäle als exakte Flächen.",
  "browser_action": {
    "default_title": "STL Reverse",
    "default_icon": {
      "48": "icons/icon48.png",
      "96": "icons/icon96.png"
    },
    "default_area": "navbar"
  },
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": false
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "{0f69a2ea-bf50-42ba-8055-dba7d55e509f}",
      "strict_min_version": "140.0",
      "update_url": "https://raw.githubusercontent.com/JustNotesa/stlReverse/main/updates.json",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [],
  "content_security_policy": "script-src 'self' 'unsafe-eval'; object-src 'self'",
  "web_accessible_resources": [
    "analysis-worker.js",
    "libs/three.module.js",
    "libs/OrbitControls.js",
    "libs/occt/occt-import-js-worker.js",
    "libs/occt/occt-import-js.js",
    "libs/occt/occt-import-js.wasm"
  ],
  "icons": {
    "48": "icons/icon48.png",
    "96": "icons/icon96.png"
  }
}
