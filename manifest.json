{
  "manifest_version": 2,
  "name": "STL Reverse Parametric Sketch",
  "version": "0.2.0",
  "description": "Wandelt STL-Meshes heuristisch in eine parametrische Zeichnung um und liefert ortho-Projektionen.",
  "browser_action": {
    "default_title": "STL Reverse",
    "default_icon": {
      "48": "icons/icon48.png",
      "96": "icons/icon96.png"
    },
    "default_area": "navbar"
  },
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": false
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "stlreverse@example.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [],
  "content_security_policy": "script-src 'self' 'unsafe-eval'; object-src 'self'",
  "web_accessible_resources": [
    "analysis-worker.js",
    "libs/three.module.js",
    "libs/OrbitControls.js",
    "libs/occt/occt-import-js-worker.js",
    "libs/occt/occt-import-js.js",
    "libs/occt/occt-import-js.wasm"
  ],
  "icons": {
    "48": "icons/icon48.png",
    "96": "icons/icon96.png"
  }
}
